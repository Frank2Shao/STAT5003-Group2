library(readr)
library(dplyr)
library(caret)
library(recipes)
library(ggplot2)
if (!exists("scaled_recipe")) {source("R/06_model_setup.R")}
dir.create("outputs/lda/", recursive=TRUE, showWarnings=FALSE)
# Training Model
lda_recipe <- scaled_recipe %>% # Additional pre-processing
step_lincomb(all_numeric_predictors()) %>%
step_corr(all_numeric_predictors(), threshold = 0.9)
lda_fit_equal <- train(
lda_recipe,
data = training_model_data,
trControl = model_control,
method = "lda2",
metric = "Macro_F1",
tuneGrid = expand.grid(dimen=1:2), # Only 2 possible values for hyperparam tuning
prior = rep(1/3, 3) # To account for class imbalance in the dataset
)
lda_fit_emp <- train(
lda_recipe,
data = training_model_data,
trControl = model_control,
method = "lda2",
metric = "Macro_F1",
tuneGrid = expand.grid(dimen=1:2) # Only 2 possible values for hyperparam tuning
)
lda_fit$resample
lda_fit$results
lda_fit$bestTune
# Performance on data
## With vs. Without Class Priors
### Side by side
prior_comparison <- bind_rows(
lda_fit_emp$results |> mutate(priors = "Empirical"),
lda_fit_equal$results   |> mutate(priors = "Equal")
) %>%
dplyr::select(priors, dimen, Macro_F1, Accuracy, starts_with("Recall_"))
print(prior_comparison)
### Per-fold comparison
fold_comparison <- bind_rows(
lda_fit_emp$resample |> mutate(priors = "Empirical"),
lda_fit_equal$resample   |> mutate(priors = "Equal")
)
fold_comparison %>%
group_by(priors) %>%
summarise(
mean_macro_f1 = mean(Macro_F1),
sd_macro_f1   = sd(Macro_F1),
.groups = "drop"
)
### Paired difference per fold (equal - emp)
paired_diff <- fold_comparison %>%
dplyr::select(Resample, priors, Macro_F1) %>%
tidyr::pivot_wider(names_from = priors, values_from = Macro_F1) %>%
mutate(diff = `Equal` - `Empirical`)
print(paired_diff)
## Test Data
lda.preds<- predict(lda_fit, newdata=test_model_data)
lda.confusion <- confusionMatrix(data=lda.preds, reference=test_model_data$rating_tier)
lda.confusion
## Training Data (Out of Fold)
lda.train.confusion <- confusionMatrix(data=lda_fit$pred$pred, reference=lda_fit$pred$obs)
lda.train.confusion
# Evaluations
tier_levels <- levels(test_model_data$rating_tier)
## Out-of-fold predictions for the chosen dimen
oof <- lda_fit$pred
if ("dimen" %in% names(oof)) {
oof <- oof %>% filter(dimen == lda_fit$bestTune$dimen)
}
stopifnot(nrow(oof) == nrow(training_model_data))   # one prediction per service
oof_df  <- data.frame(obs = oof$obs, pred = oof$pred)
test_df <- data.frame(obs = test_model_data$rating_tier, pred = lda.preds)
## Overall metrics: CV (fold mean), CV (pooled OOF), test
best_row <- lda_fit$results %>% filter(dimen == lda_fit$bestTune$dimen)
overall <- bind_rows(
data.frame(split = "CV (mean of folds)",
t(unlist(best_row[, c("Macro_F1", "Accuracy")]))),
data.frame(split = "CV (pooled out-of-fold)",
t(macro_f1_summary(oof_df,  lev = tier_levels)[c("Macro_F1", "Accuracy")])),
data.frame(split = "Test",
t(macro_f1_summary(test_df, lev = tier_levels)[c("Macro_F1", "Accuracy")]))
)
print(overall)
## Majority-class baseline for reference
majority <- names(which.max(table(training_model_data$rating_tier)))
baseline <- data.frame(
obs  = test_model_data$rating_tier,
pred = factor(majority, levels = tier_levels)[rep(1, nrow(test_model_data))]
)
print(macro_f1_summary(baseline, lev = tier_levels)[c("Macro_F1", "Accuracy")])
## Per-class precision / recall / F1
per_class <- function(cm, split) {
bc <- as.data.frame(cm$byClass)
bc$class <- sub("^Class: ", "", rownames(bc))
bc$split <- split
bc[, c("split", "class", "Precision", "Recall", "F1")]
}
class_metrics <- bind_rows(
per_class(lda.train.confusion, "CV (out-of-fold)"),
per_class(lda.confusion,       "Test")
)
print(class_metrics)
write_csv(class_metrics, "outputs/lda/LDA_class_metrics.csv")
## Ordinal view: quadratic weighted kappa and how far off errors are
qw_kappa <- function(obs, pred) {
k <- nlevels(obs)
O <- table(obs, pred); O <- O / sum(O)
E <- outer(rowSums(O), colSums(O))
W <- outer(seq_len(k), seq_len(k), function(i, j) (i - j)^2 / (k - 1)^2)
1 - sum(W * O) / sum(W * E)
}
cat("\nQuadratic weighted kappa  CV:  ", round(qw_kappa(oof_df$obs,  oof_df$pred),  3),
"\nQuadratic weighted kappa  Test:", round(qw_kappa(test_df$obs, test_df$pred), 3), "\n")
tier_distance <- abs(as.integer(test_df$obs) - as.integer(test_df$pred))
cat("\nTest error distance (0 = correct, 1 = adjacent tier, 2 = Below<->Above):\n")
print(round(100 * prop.table(table(tier_distance)), 1))
## Provider-level bootstrap CI for test Macro F1
# test_data and test_model_data share row order (same filter, same rows).
stopifnot(nrow(test_data) == nrow(test_model_data))
set.seed(5005)
provider_rows <- split(seq_len(nrow(test_data)), test_data$provider_id)
providers     <- names(provider_rows)
boot_f1 <- replicate(1000, {
sampled <- sample(providers, replace = TRUE)
idx     <- unlist(provider_rows[sampled], use.names = FALSE)
macro_f1_summary(test_df[idx, ], lev = tier_levels)[["Macro_F1"]]
})
cat("\nTest Macro F1 95% bootstrap CI (resampling providers):",
round(quantile(boot_f1, c(0.025, 0.975)), 3), "\n")
## Plots
plot_cm <- function(cm, title) {
df <- as.data.frame(cm$table) %>%
group_by(Reference) %>%
mutate(row_pct = 100 * Freq / sum(Freq)) %>%
ungroup()
ggplot(df, aes(Prediction, Reference, fill = row_pct)) +
geom_tile(colour = "white") +
geom_text(aes(label = paste0(Freq, "\n(", round(row_pct, 1), "%)")), size = 4) +
scale_fill_gradient(low = "white", high = "steelblue", name = "% of true class") +
scale_y_discrete(limits = rev(levels(df$Reference))) +
labs(title = title, x = "Predicted rating", y = "Actual rating") +
coord_fixed() +
theme_minimal()
}
lda.test.plot  <- plot_cm(lda.confusion,       "LDA Predictions on Test Set")
lda.train.plot <- plot_cm(lda.train.confusion, "LDA Cross-Validated Predictions (Training Set)")
lda.metric.plot <- class_metrics %>%
tidyr::pivot_longer(c(Precision, Recall, F1), names_to = "metric", values_to = "value") %>%
mutate(class = factor(class, levels = tier_levels)) %>%
ggplot(aes(class, value, fill = split)) +
geom_col(position = position_dodge(width = 0.8), width = 0.7) +
facet_wrap(~ metric) +
scale_y_continuous(limits = c(0, 1)) +
labs(title = "LDA per-class metrics", x = NULL, y = NULL, fill = NULL) +
theme_minimal() +
theme(axis.text.x = element_text(angle = 30, hjust = 1))
ggsave("figures/lda_train_cm.png",      lda.train.plot,  width = 6, height = 6, dpi = 220)
ggsave("figures/lda_test_cm.png",       lda.test.plot,   width = 6, height = 6, dpi = 220)
ggsave("figures/lda_class_metrics.png", lda.metric.plot, width = 9, height = 4, dpi = 220)
